# Salin ke /etc/spm.env (chmod 600). JANGAN commit fail ini yang sudah diisi ke GitHub.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=kunci-anon-atau-biasa
# Kunci servis: hanya untuk jadual kata_laluan (lihat kata_laluan.sql). Jangan letak dalam kod.
SUPABASE_SERVICE_KEY=
JPN_PASSWORD=tukar-kata-laluan-kuat-jpn
DISABLE_MASTER_PASSWORD=true
AUTH_DB_ONLY=false
DISABLE_PADAM_SURAT=true
